{
  "name": "live-minutes",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "跨裝置雙語即時字幕 + AI 會議紀錄 PWA（GitHub → Cloudflare）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "worker:dev": "wrangler dev",
    "worker:typecheck": "tsc -p worker/tsconfig.json --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute live_minutes --file=./schema.sql"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "wrangler": "^3.80.0"
  }
}
